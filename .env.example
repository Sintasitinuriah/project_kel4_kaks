# ==============================================================================
# Defense-in-Depth SQL Injection Mitigation - Environment Configuration
# Salin file ini menjadi .env sebelum menjalankan docker compose
# ==============================================================================

# --- WAF (Nginx + ModSecurity v3 + OWASP CRS) ---
# Mode WAF:
#   On            = Blocking Mode (memblokir SQLi dengan HTTP 403 Forbidden)
#   DetectionOnly = Detection Mode (meneruskan trafik, mencatat alert SQLi di audit log)
#   Off           = Bypass Mode (tanpa proteksi WAF, untuk uji baseline Layer 3 & 4)
MODSEC_RULE_ENGINE=On

# Level sensitivitas OWASP CRS (1 = standar, 2-4 = lebih ketat)
CRS_PARANOIA=1

# Port host untuk mengakses WAF (satu-satunya port yang diekspos ke luar)
WAF_PORT=8080

# --- Web Application (Flask) ---
FLASK_SECRET_KEY=uas-cloud-sec-change-me-in-production

# --- Database (PostgreSQL 16) ---
# Superuser: HANYA digunakan untuk inisialisasi kontainer DB, TIDAK diberikan ke Web App
POSTGRES_DB=cloudshop_db
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=SuperSecretAdminPass!2026

# Application User (Least Privilege: hanya SELECT, INSERT, UPDATE pada tabel aplikasi)
APP_DB_USER=app_user
APP_DB_PASSWORD=AppUserSecurePass!2026
